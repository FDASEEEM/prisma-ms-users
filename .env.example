PORT=3001
CORS_ORIGIN=http://localhost:3002,http://127.0.0.1:3002
# Desactivar CORS en producción cuando API Gateway maneja CORS
ENABLE_CORS=true
NODE_ENV=development

DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# AWS Cognito — Auth provider
# Create a User Pool in AWS Cognito with:
#   - Google as a Social Provider (Identity Provider)
#   - App Client with NO client secret (public client)
#   - Custom attributes: role (String), colegioId (String)
#   - OAuth callback URL matching GOOGLE_REDIRECT_URL
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-cognito-app-client-id
COGNITO_REGION=us-east-1
# Cognito domain for the Hosted UI / OAuth2 endpoints (authorize + token live HERE, not at the issuer)
COGNITO_DOMAIN=prisma.auth.us-east-1.amazoncognito.com
# Opcionales (solo desarrollo local con mock): apuntan a dev/mock-cognito/server.js
# COGNITO_ISSUER=http://localhost:9299
# COGNITO_ENDPOINT=http://localhost:9299
