PORT=3001
CORS_ORIGIN=http://localhost:3002,http://127.0.0.1:3002
# Desactivar CORS en producción cuando API Gateway maneja CORS
ENABLE_CORS=true
NODE_ENV=development

DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# AWS Cognito — Auth provider
# Create a User Pool in AWS Cognito with:
#   - Google as a Social Provider (Identity Provider)
#   - App Client with NO client secret (public client)
#   - Custom attributes: role (String), colegioId (String)
#   - OAuth callback URL matching GOOGLE_REDIRECT_URL
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-cognito-app-client-id
COGNITO_REGION=us-east-1
# Cognito domain for the Hosted UI / OAuth2 endpoints (authorize + token live HERE, not at the issuer)
COGNITO_DOMAIN=https://<your-pool>.auth.<region>.amazoncognito.com

# OAuth: lista blanca (separada por comas) de URLs de callback aceptadas como
# `redirectTo` en /api/auth/google/url y /api/auth/google/callback.
# Se aplica SOLO cuando NODE_ENV=production; si queda vacía en producción el
# login con Google se rechaza (fail-closed). Debe incluir el callback del BFF.
GOOGLE_CALLBACK_ALLOWLIST=http://localhost:3010/api/auth/google/callback
